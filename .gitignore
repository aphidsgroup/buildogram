# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
# Skill binary assets (tracked via LFS - exclude if LFS not configured)
.agents/skills/*/assets/*.jpg
.agents/skills/*/assets/*.png
.agents/skills/*/assets/*.gif

# secrets
google-credentials.json
*.credentials.json

# local scratch/build logs
build-output.txt
build_errors.txt
build_phase4.txt
lint-output.txt
lint-remediation-baseline.txt

# local scratch
scratch/

# verification outputs — may contain preview hostnames
seo-growth/preview-results/

# Local deployment and verification outputs
/bypass.txt
/deploy-output*.txt
/local-verification.txt
/verification-output*.txt
