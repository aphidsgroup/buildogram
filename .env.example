APP_MODE=
DATABASE_URL=

# Authentication and canonical URLs
JWT_SECRET=
COOKIE_SECRET=
NEXT_PUBLIC_SITE_URL=https://www.buildogram.in

# Required Preview analytics
NEXT_PUBLIC_GA_ID=

# Explicit release feature gates
ENABLE_PROVIDER_AI=false
ENABLE_ONLINE_PAYMENTS=false
ENABLE_WHATSAPP_AUTOMATION=false
ENABLE_CLOUDINARY_UPLOADS=false
ENABLE_EMAIL_DELIVERY=false
ENABLE_PILOT_SEED=false

# Optional provider AI (only used when ENABLE_PROVIDER_AI=true)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Optional online payments (only used when ENABLE_ONLINE_PAYMENTS=true)
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional WhatsApp automation (click-to-chat does not need these)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=

# Optional Cloudinary uploads
FILE_STORAGE_PROVIDER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email delivery
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
